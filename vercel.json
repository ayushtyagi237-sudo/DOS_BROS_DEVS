{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/arlixa", "destination": "/arlixa/index.html" },
    { "source": "/fuelex", "destination": "/fuelex/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
